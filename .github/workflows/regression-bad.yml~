name: Regression tests

on:
  push:
    branches: ['main']  # Trigger on push to main (after merged PR)
  pull_request:
    branches: ['*'] # Trigger on pull requests for all branches

# Concurrency control to cancel previous runs on new push to same PR/branch
concurrency:
  group: ${{ github.workflow }}-${{ github.event_name == 'pull_request' && github.event.pull_request.number || github.ref }}
  cancel-in-progress: true  # Automatically cancel any previous runs for the same group

env:
  DEV_HOME: /home/gpadmin
  PXF_HOME: /usr/local/greengage-db-devel/pxf
  GPHOME:   /usr/local/greengage-db-devel
  GOPATH:   /opt/go

jobs:
  regression:
    name: Run regression on ${{ matrix.version }}
    runs-on: ubuntu-latest
    timeout-minutes: 180

    strategy:
      matrix:
        include:
          - image: greengagedb/ggdb6_ubuntu:6.29.1
            dev_home: /home/gpadmin
            version: dh-6.29.1
          - image: ghcr.io/greengagedb/greengage/ggdb6_ubuntu:latest
            dev_home: /home/gpadmin
            version: ghcr-latest

    # Build in developer's Greengage image from GHCR
    container:
      image: ${{ matrix.image }}
      volumes:
        - ${{ github.workspace }}:${{ matrix.dev_home }}/pxf
        - ./logs:/logs
      options: >-
        --privileged
        --sysctl kernel.sem="500 1024000 200 4096"
      env:
        PXF_HOME: ${{ env.PXF_HOME }}
        DEV_HOME: ${{ matrix.dev_home }}
        PXF_SRC: ${{ matrix.dev_home }}/pxf
        GPHOME: ${{ env.GPHOME }}
        GOPATH: ${{ env.GOPATH }}
        PATH: ${{ env.GPHOME }}/bin:${{ env.PXF_HOME }}/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/local/go/bin:${{ env.GOPATH }}/bin
        JAVA_TOOL_OPTIONS: -Dfile.encoding=UTF8
        DEBIAN_FRONTEND: noninteractive

    steps:
      - uses: actions/checkout@v4

      - name: Build PXF regression image ${{ matrix.version }}
        shell: bash
        run: |
          set -eux
          cd $PXF_SRC
          bash ci/build_in_docker.sh

      # Run Regression tests
      - name: Regression tests
        shell: bash
        run: |
          set +e
          git config --global --add safe.directory /__w/pxf/pxf
          $PXF_SRC/ci/test_in_docker.sh
          status=$?
          find $PXF_SRC/fdw -type f -name "*.diffs" -exec mv -f {} /logs \;
          echo ">>> STATUS $status"
          exit ${status:-1}

      # Upload regression tests artifacts
      - name: Upload regression artifacts
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: logs_regression-${{ matrix.version }}
          path: logs
          retention-days: 7
          if-no-files-found: warn  # Warning if no artifacts are found
