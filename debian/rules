#!/usr/bin/make -f

DH_VERBOSE = 1

GPHOME   ?= /opt/greengagedb/greengage
PXF_HOME ?= $(GPHOME)/pxf

export DH_OPTIONS = -v
export DEB_BUILD_OPTIONS = nocheck
export PG_CONFIG=$(GPHOME)/bin/pg_config
export PATH := /usr/local/go/bin:$(PATH)

%:
	dh $@

override_dh_auto_clean:
	@echo "Skipping clean"

override_dh_auto_configure:
	@echo "Skipping configure"

override_dh_auto_build:
	@echo "Skipping autobuild"

override_dh_auto_install:
	@echo "=== DeBuilder Installing PXF modules into $$PXF_HOME ==="
	env -u CFLAGS -u CPPFLAGS -u CXXFLAGS -u LDFLAGS -u MAKEOVERRIDES \
	PATH=$(GPHOME)/bin:/usr/local/go/bin:$(PATH) \
	PYTHONPATH=$(PYTHONPATH) \
	LD_LIBRARY_PATH=$(LD_LIBRARY_PATH) \
	$(MAKE) install \
		DESTDIR=$(CURDIR)/debian/tmp \
		GPHOME=$(GPHOME) \
		PXF_HOME=$(PXF_HOME) \
		SKIP_TESTS=true

override_dh_dwz:
	@echo "Skipping debug simbols compression (not working properly with Golang)"
	dh_dwz -Xpxf-cli

override_dh_gencontrol:
	@echo "=== Generating control files ==="
	dh_gencontrol
